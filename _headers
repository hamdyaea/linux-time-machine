# Global security headers; CSP is deliberately route-specific because multiple CSP
# headers are intersected by browsers (a restrictive global CSP blocks blob workers).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The homepage and VM permit blob-backed v86 disk/worker assets; other pages remain strict.
/
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' blob: https://linux-time-machine-disk.hamdy-aea.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

